{
    "name": "dereuromark/cakephp-file-storage",
    "description": "Upload, store and serve files in CakePHP using Flysystem adapters, with image variants and a database record for each file.",
    "license": "MIT",
    "type": "cakephp-plugin",
    "keywords": [
        "file",
        "filesystem",
        "media",
        "abstraction",
        "upload",
        "cakephp",
        "storage",
        "admin-panel"
    ],
    "authors": [
        {
            "name": "Mark Scherer",
            "homepage": "https://github.com/dereuromark"
        },
        {
            "name": "Other contributors",
            "homepage": "https://github.com/dereuromark/cakephp-file-storage/graphs/contributors",
            "role": "Contributors"
        }
    ],
    "homepage": "https://dereuromark.github.io/cakephp-file-storage/",
    "support": {
        "issues": "https://github.com/dereuromark/cakephp-file-storage/issues",
        "source": "https://github.com/dereuromark/cakephp-file-storage",
        "docs": "https://dereuromark.github.io/cakephp-file-storage/"
    },
    "require": {
        "php": ">=8.5",
        "brick/varexporter": "^0.7.0",
        "cakephp/cakephp": "^6.0@dev",
        "php-collective/file-storage": "^1.1.0"
    },
    "require-dev": {
        "cakephp/migrations": "dev-fix/6.x-cakephp-compatibility",
        "dereuromark/cakephp-i18n-lint": "dev-cake6",
        "dereuromark/cakephp-queue": "dev-cake6",
        "php-collective/code-sniffer": "dev-master",
        "php-collective/file-storage-image-processor": "^1.0 || ^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "cakephp/migrations": "For migrations to run.",
        "php-collective/file-storage-image-processor": "Required if you want to use the image processing feature of FileStorage",
        "dereuromark/cakephp-queue": "For background image-variant regeneration from the admin UI."
    },
    "conflict": {
        "cakephp/migrations": "<4.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "FileStorage\\": "src/",
            "FileStorage\\Test\\Fixture\\": "tests/Fixture/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FileStorage\\Test\\TestCase\\": "tests/TestCase/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@stan"
        ],
        "coverage-test": "phpunit --stderr --coverage-clover=clover.xml",
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "lowest": "validate-prefer-lowest",
        "lowest-setup": "composer update --prefer-lowest --prefer-stable --prefer-dist --no-interaction && cp composer.json composer.backup && composer require --dev dereuromark/composer-prefer-lowest && mv composer.backup composer.json",
        "stan": "phpstan analyze",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan:^2.0.0 && mv composer.backup composer.json",
        "stan-test": "phpstan analyze tests/",
        "test": "phpunit",
        "i18n-check": "i18n-lint check",
        "i18n-extract": "i18n-lint extract",
        "i18n-lint": "i18n-lint lint"
    }
}
